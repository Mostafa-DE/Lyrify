<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Lyrify</string>

    <string name="setup_intro">Lyrify adds synced lyrics for the songs on your phone to Samsung Music. Two switches to turn on:</string>
    <string name="setup_notifications_title">Notification access</string>
    <string name="setup_notifications_detail">Lets Lyrify see what Samsung Music is playing and what comes next in the queue. Your notifications are not read.</string>
    <string name="setup_notifications_action">Open notification access</string>
    <string name="setup_files_title">All files access</string>
    <string name="setup_files_detail">Lets Lyrify find your songs and save a .lrc lyrics file next to each one. It never changes, moves or deletes your music.</string>
    <string name="setup_files_action">Allow all files access</string>
    <string name="setup_done">On</string>
    <string name="setup_restricted_title">Switch greyed out?</string>
    <string name="setup_restricted_detail">Android restricts this for apps installed outside a store. In App info tap ⋮ (top right) › Allow restricted settings, then try again.</string>
    <string name="setup_samsung_title">Keep it running on Samsung</string>
    <string name="setup_samsung_detail">Settings › Battery › Background usage limits › Never sleeping apps › add Lyrify.</string>
    <string name="open_app_info">Open App info</string>

